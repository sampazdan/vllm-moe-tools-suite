{
  "category": "NVIDIA",
  "containerDiskInGb": 50,
  "dockerEntrypoint": [],
  "dockerStartCmd": [],
  "env": {
    "MOE_TOOLS_APP_STARTUP_TIMEOUT_SECONDS": "300",
    "MOE_TOOLS_AUTH_TOKEN": "{{ RUNPOD_SECRET_moe_tools_auth_token }}",
    "MOE_TOOLS_COOKIE_SECURE": "1",
    "MOE_TOOLS_DATA_DIR": "/workspace/moe-tools",
    "MOE_TOOLS_MODE": "mock",
    "MOE_TOOLS_REQUIRE_AUTH": "1",
    "RUNPOD_ENABLE_REQUEST_METRICS": "1",
    "RUNPOD_REASONING_PARSER": "qwen3",
    "RUNPOD_VLLM_GPU_MEMORY_UTILIZATION": "0.90",
    "RUNPOD_VLLM_HOST": "127.0.0.1",
    "RUNPOD_VLLM_MAX_MODEL_LEN": "4096",
    "RUNPOD_VLLM_MAX_NUM_BATCHED_TOKENS": "2048",
    "RUNPOD_VLLM_MAX_NUM_SEQS": "8",
    "RUNPOD_VLLM_MODEL": "Qwen/Qwen3.6-35B-A3B-FP8",
    "RUNPOD_VLLM_PORT": "8000"
  },
  "imageName": "ghcr.io/sampazdan/vllm-moe-tools-suite:0.3.0-rc.1",
  "isPublic": false,
  "isServerless": false,
  "name": "moe-tools-test-suite-mock",
  "ports": [
    "8080/http",
    "22/tcp"
  ],
  "readme": "Private MoE expert-routing research appliance. Open port 8080 through Runpod's HTTPS proxy and sign in with the configured token.",
  "volumeInGb": 150,
  "volumeMountPath": "/workspace"
}
