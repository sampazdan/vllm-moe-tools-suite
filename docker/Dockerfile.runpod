# syntax=docker/dockerfile:1.7

FROM --platform=linux/amd64 node:24.6.0-bookworm-slim AS frontend-build
WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/ ./
RUN npm run build

FROM --platform=linux/amd64 runpod/pytorch:1.0.3-cu1300-torch290-ubuntu2404@sha256:393d78eef4ad2b5440f2545848a1257078494604e3c3df6b98b0631de4d5f7bb

ARG VLLM_PRECOMPILED_WHEEL_COMMIT=b1e12d142d8c9533f857f8da13d8fc368e95a8cd
ARG VLLM_PRECOMPILED_WHEEL_VARIANT=cu130
ARG VLLM_IMAGE_VERSION=0.1.dev1+moe-tools
ARG VLLM_SOURCE_REF=stage-2-worktree

LABEL org.opencontainers.image.title="MoE Tools Test Suite" \
      org.opencontainers.image.description="Interactive expert-routing and pruning research appliance" \
      org.opencontainers.image.revision="${VLLM_SOURCE_REF}"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    UV_HTTP_TIMEOUT=500 \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/root/.cache/uv \
    PATH=/opt/vllm-venv/bin:/root/.local/bin:${PATH} \
    VIRTUAL_ENV=/opt/vllm-venv \
    HF_HOME=/workspace/cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/workspace/cache/huggingface/hub \
    VLLM_CACHE_ROOT=/workspace/cache/vllm \
    TORCHINDUCTOR_CACHE_DIR=/workspace/cache/torchinductor \
    TRITON_CACHE_DIR=/workspace/cache/triton \
    RUNPOD_RESULTS_DIR=/workspace/results \
    RUNPOD_VLLM_SOURCE_REF=${VLLM_SOURCE_REF} \
    RUNPOD_VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8 \
    RUNPOD_VLLM_HOST=127.0.0.1 \
    RUNPOD_VLLM_PORT=8000 \
    RUNPOD_VLLM_MAX_MODEL_LEN=4096 \
    RUNPOD_VLLM_GPU_MEMORY_UTILIZATION=0.90 \
    RUNPOD_VLLM_MAX_NUM_BATCHED_TOKENS=2048 \
    RUNPOD_VLLM_MAX_NUM_SEQS=8 \
    VLLM_USE_DEEP_GEMM=0 \
    MOE_TOOLS_MODE=mock \
    MOE_TOOLS_REQUIRE_AUTH=1 \
    MOE_TOOLS_COOKIE_SECURE=1 \
    MOE_TOOLS_APP_ROOT=/opt/moe-tools-test-suite \
    MOE_TOOLS_DATA_DIR=/workspace/moe-tools \
    MOE_TOOLS_FRONTEND_DIST=/opt/moe-tools-test-suite/frontend/dist \
    MOE_TOOLS_VLLM_BASE_URL=http://127.0.0.1:8000

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        htop \
        iproute2 \
        jq \
        less \
        ninja-build \
        numactl \
        pciutils \
        procps \
        sysstat \
        time \
        tmux \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && uv venv --python 3.12 /opt/vllm-venv

WORKDIR /opt/vllm-src
COPY --from=vllm_source . .
RUN --mount=type=cache,target=/root/.cache/uv \
    VLLM_USE_PRECOMPILED=1 \
    VLLM_PRECOMPILED_WHEEL_COMMIT="${VLLM_PRECOMPILED_WHEEL_COMMIT}" \
    VLLM_PRECOMPILED_WHEEL_VARIANT="${VLLM_PRECOMPILED_WHEEL_VARIANT}" \
    VLLM_VERSION_OVERRIDE="${VLLM_IMAGE_VERSION}" \
    uv pip install \
        --python /opt/vllm-venv/bin/python \
        --editable ".[bench]" \
        --torch-backend=auto

WORKDIR /opt/moe-tools-test-suite
COPY pyproject.toml README.md ./
COPY backend/ backend/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /opt/vllm-venv/bin/python .
COPY --from=frontend-build /build/frontend/dist frontend/dist

COPY --from=vllm_source docker/runpod/profile.sh /etc/profile.d/vllm-runpod.sh
COPY --from=vllm_source docker/runpod/runpod-serve.sh /usr/local/bin/runpod-serve
COPY --from=vllm_source docker/runpod/runpod-bench.sh /usr/local/bin/runpod-bench
COPY --from=vllm_source docker/runpod/make_moe_profile.py /usr/local/bin/make-moe-profile
COPY docker/runpod/pre_start.sh /pre_start.sh

RUN chmod 0755 \
        /pre_start.sh \
        /usr/local/bin/runpod-serve \
        /usr/local/bin/runpod-bench \
        /usr/local/bin/make-moe-profile \
    && chmod 0644 /etc/profile.d/vllm-runpod.sh \
    && /opt/vllm-venv/bin/python -c "import moe_tools_suite, torch, vllm; print(moe_tools_suite.__version__, vllm.__version__, torch.__version__)"

WORKDIR /workspace
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:8080/readyz >/dev/null || exit 1

# Inherit the Runpod base CMD. /start.sh invokes /pre_start.sh, preserving SSH,
# the web terminal, and Jupyter while starting this application automatically.
